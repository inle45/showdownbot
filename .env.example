# ---- Compte Pokemon Showdown ----
# Laisser vide pour jouer en local sur un serveur --no-security (aucun mot de passe requis).
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=

# local  = serveur Showdown tournant sur le telephone (ws://localhost:8000/showdown/websocket)
# online = serveur officiel sim3.psim.us
SHOWDOWN_SERVER=local

# ---- API Anthropic ----
# Utilisee UNIQUEMENT pour l'analyse post-combat et la consolidation periodique.
# Jamais pendant un combat.
ANTHROPIC_API_KEY=

# Modele des deux appels. Cout observe affiche dans le dashboard.
ANALYSIS_MODEL=claude-sonnet-5
CONSOLIDATION_MODEL=claude-sonnet-5

# Effort de raisonnement: low | medium | high | xhigh | max
# medium suffit largement pour classer des observations dans un vocabulaire
# ferme de 27 tags: en pratique, "high" a pousse le raisonnement adaptatif a
# consommer a lui seul plus de 24000 tokens sur un combat de taille normale,
# et la reponse finale n'avait plus de budget pour s'ecrire (stop_reason
# max_tokens). Ne remonter a "high" que si les rapports medium paraissent
# superficiels, en gardant un oeil sur ce meme symptome.
ANALYSIS_EFFORT=medium

# ---- Boucle d'auto-amelioration ----
# Consolider les lecons tous les N combats.
CONSOLIDATE_EVERY=10

# propose = les ajustements de parametres attendent ton approbation (dashboard ou CLI)
# auto    = ils s'appliquent seuls (a n'activer qu'une fois les propositions jugees sensees)
TUNING_MODE=propose

# ---- Comportement du bot ----
BATTLE_FORMAT=gen9randombattle

# Ladder public. Volontairement desactive par defaut: a activer explicitement.
ENABLE_LADDER=false

# Notifications Termux:API en fin de combat (necessite `pkg install termux-api`
# et l'application Termux:API installee).
TERMUX_NOTIFICATIONS=false
