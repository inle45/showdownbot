# ---- Compte Pokemon Showdown ----
# Laisser vide pour jouer en local sur un serveur --no-security (aucun mot de passe requis).
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=

# local  = serveur Showdown tournant sur le telephone (ws://localhost:8000/showdown/websocket)
# online = serveur officiel sim3.psim.us
SHOWDOWN_SERVER=local

# ---- API Anthropic ----
# Utilisee UNIQUEMENT pour l'analyse post-combat et la consolidation periodique.
# Jamais pendant un combat.
ANTHROPIC_API_KEY=

# Modele des deux appels. Cout observe affiche dans le dashboard.
ANALYSIS_MODEL=claude-sonnet-5
CONSOLIDATION_MODEL=claude-sonnet-5

# Raisonnement interne (extended thinking) avant la reponse. Desactive par
# defaut: mesure en conditions reelles, meme au niveau d'effort le plus bas
# ("low"), le raisonnement adaptatif consommait a lui seul 12000-13000 tokens
# de sortie sur un combat de taille normale (~0,14$/combat) - le dial
# d'effort ne bornait pas ce cout comme attendu pour cette tache de
# classification dans un vocabulaire ferme. Le reactiver a son cout: mesurer
# a nouveau avant de generaliser sur beaucoup de combats.
ANALYSIS_THINKING=false

# N'a d'effet que si ANALYSIS_THINKING=true. low | medium | high | xhigh | max
ANALYSIS_EFFORT=low

# ---- Boucle d'auto-amelioration ----
# Consolider les lecons tous les N combats.
CONSOLIDATE_EVERY=10

# propose = les ajustements de parametres attendent ton approbation (dashboard ou CLI)
# auto    = ils s'appliquent seuls (a n'activer qu'une fois les propositions jugees sensees)
TUNING_MODE=propose

# ---- Comportement du bot ----
BATTLE_FORMAT=gen9randombattle

# Ladder public. Volontairement desactive par defaut: a activer explicitement.
ENABLE_LADDER=false

# Notifications Termux:API en fin de combat (necessite `pkg install termux-api`
# et l'application Termux:API installee).
TERMUX_NOTIFICATIONS=false

# Ouvre automatiquement le lien spectateur dans le navigateur au debut de
# chaque combat (meme prerequis que ci-dessus: Termux:API). Copier une URL
# depuis un terminal etroit sur telephone est peu fiable (elle se coupe sur
# plusieurs lignes) - utile pour challenge/ladder en petit nombre, a laisser
# desactive pour un gros volume de combats (selfplay, ladder prolonge): sinon
# un nouvel onglet s'ouvre a chaque combat.
TERMUX_OPEN_SPECTATOR=false
